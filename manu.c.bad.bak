/*进入具体参数调整界面
*为了增加代码复用性而产生的函数
*用于二级菜单下面的函数
*输入参数1：全局变量
*输入参数2：eeprom的地址数值传入
*输入参数3：二级菜单下的局部变量地址传入

*注意：两个字符串显示函数不包括在此函数内需要在此函数前加对应显示字符串的函数语句
用处是提示此次更改数据的数据名字是什么
例如：	
	tft180_clear(RGB565_BLACK);//先清屏幕
	tft180_show_string(8, 16*0, "kp:"); 			
	tft180_show_string(8, 16*3, "kp_elast:"); 			
*注意：加在此函数后面
	ok_button=0;//标志位置回零，防止立刻再次进入此case

*///uint16

uint16 Specific_para_adjust(uint16 _munuout,uint32 _munu_addr,uint16  _Local,float _mannu_k)
{
	uint16 origin_value;
	uint16 last_local;
	uint16 last_munuout;
	float last_float;
	uint8 changed;
	float now_float;
//	tft180_clear(RGB565_BLACK);//先清屏幕
//	tft180_show_string(8, 16*0, "kp:"); 			//3
//static uint32 Transit_Local=* _Local;
	origin_value = manu_eeprom_read_u16(_munu_addr);
	_Local = origin_value;

//	tft180_show_string(8, 16*3, "kp_elast:"); 			//3
	tft180_show_uint16(8, 16*4, origin_value);
	if(_munuout!=_Local)
	{
		_Local=_munuout;
	}

	last_local = (uint16)(~_Local);
	last_munuout = (uint16)(~_munuout);
	last_float = -1.0f;

	tft180_show_uint16(8, 16*1, _Local);

	//加减原本数据
	while(1)
	{
		changed = 0;
		if(gpio_get_level(IO_P37)==0)//加一按键
		{
			Manu_keydelay(IO_P37);

			//优化点，按键延时优化
		  _Local++;
		  changed = 1;
			
		}
		 if(gpio_get_level(IO_P36)==0)//减一按键
		{
			Manu_keydelay(IO_P36);

			//优化点，按键延时优化
		  _Local--;
		  changed = 1;
			
		}
		if(gpio_get_level(IO_P46)==0)//确认按键，后续统一一起存入eeprom，然后返回参数设置选择
		{
			Manu_keydelay(IO_P46);

			//优化点，按键延时优化			
		  return _Local;

		}
		if(gpio_get_level(IO_P45)==0)//返回按键，返回上一级菜单函数，
		{
			Manu_keydelay(IO_P45);

			//优化点，按键延时优化	
		//	ok_button=1;
			return _Local;
		}


		_munuout=_Local;
		now_float = _munuout * _mannu_k;
		if (changed || last_local != _Local)
		{
			tft180_show_uint16(8, 16*1, _Local);
			last_local = _Local;
		}
		if (changed || last_munuout != _munuout)
		{
			tft180_show_uint16(8, 16*2, _munuout);
			last_munuout = _munuout;
		}
		if (changed || last_float != now_float)
		{
			tft180_show_float(8,16*5, now_float, 6, 6);
			last_float = now_float;
		}
		system_delay_ms(1);

//		ok_button=0;//标志位置回零，防止立刻再次进入此case
	}
}





/*
优化尺寸
*显示光标函数

*/
void Manu_show_cursor(uint8 cursor)
{
	static uint8 last_cursor = 0;
	if (cursor == last_cursor)
	{
		return;
	}
	if (last_cursor >= 1 && last_cursor <= 10)
	{
		tft180_show_string(0, 16 * (last_cursor - 1), " ");
	}
	if (cursor >= 1 && cursor <= 10)
	{
		tft180_show_string(0, 16 * (cursor - 1), "*");
	}
	last_cursor = cursor;
}




/*
按键延时函数优化
*/

void Manu_keydelay(gpio_pin_enum pin)
{
system_delay_ms(10);
while(gpio_get_level(pin)==0);
  system_delay_ms(10);
}

