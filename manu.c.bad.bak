/***********************************************/
/*
二级菜单角度环参数调整函数

*/

int Manu_two_adjust(void)
{
	ManuKeyEvent event;
	uint8 was_editing;

	manu_menu_setup();
	manu_menu_state.current = &turn_menu;
	manu_menu_state.selected = 1;
	manu_menu_state.editing = 0;
	manu_menu_state.current->render();
	Manu_show_cursor(manu_menu_state.selected);

	while (1)
	{
		event = manu_key_confirm();
		if (event == MANU_KEY_NONE)
		{
			system_delay_ms(1);
			continue;
		}
		was_editing = manu_menu_state.editing;
		manu_menu_handle_key(event);
		if (event == MANU_KEY_BACK && !was_editing)
		{
			break;
		}
		system_delay_ms(1);
	}
	return 0;
}

int Manu_two_adjustangle(void)//pPid_Turn_Loop pid,
{
	ManuKeyEvent event;
	uint8 was_editing;

	manu_menu_setup();
	manu_menu_state.current = &angle_menu;
	manu_menu_state.selected = 1;
	manu_menu_state.editing = 0;
	manu_menu_state.current->render();
	Manu_show_cursor(manu_menu_state.selected);

	while (1)
	{
		event = manu_key_confirm();
		if (event == MANU_KEY_NONE)
		{
			system_delay_ms(1);
			continue;
		}
		was_editing = manu_menu_state.editing;
		manu_menu_handle_key(event);
		if (event == MANU_KEY_BACK && !was_editing)
		{
			break;
		}
		system_delay_ms(1);
	}
	return 0;
}

