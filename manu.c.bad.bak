uint16 kpangle_munuout,kdangle_munuout,kiangle_munuout,maxangle_munuout,minangle_munuout,desiredangle_munuout;//角速度环
uint16 run_munuout,show_munuout,start_cap_munuout,ben_enter_munuout,ben_angle_munuout,start_distance_munuout;//全局状态变量

typedef struct
{
	uint32 addr;
	uint16 *value;
} manu_eeprom_item_t;

static uint16 manu_eeprom_read_u16(uint32 addr)
{
	return (uint16)((uint16)iap_read_byte(addr) | ((uint16)iap_read_byte(addr + 1) << 8));
}

static void manu_eeprom_write_u16(uint32 addr, uint16 value)
{
	iap_write_byte(addr, (uint8)value);
	iap_write_byte(addr + 1, (uint8)(value >> 8));
}

static void manu_save_all_to_eeprom(void)
{
	uint8 i;
	const manu_eeprom_item_t items[] = {
		{kp_munu_addr, &kp_munuout},
		{kp_3_munu_addr, &kp_3_munuout},
		{kd_munu_addr, &kd_munuout},
		{max_munu_addr, &max_munuout},
		{min_munu_addr, &min_munuout},
		{xianfumax_munu_addr, &xianfumax_munuout},
		{basic_munu_addr, &basic_munuout},
		{kpspeed_munu_addr, &kpspeed_munuout},
		{kdspeed_munu_addr, &kdspeed_munuout},
		{kispeed_munu_addr, &kispeed_munuout},

		{kpangle_munu_addr, &kpangle_munuout},
		{kiangle_munu_addr, &kiangle_munuout},
		{kdangle_munu_addr, &kdangle_munuout},
		{maxangle_munu_addr, &maxangle_munuout},
		{minangle_munu_addr, &minangle_munuout},
		{desiredangle_munu_addr, &desiredangle_munuout},

		{run_munu_addr, &run_munuout},
		{show_munu_addr, &show_munuout},
		{start_cap_munu_addr, &start_cap_munuout},
		{ben_enter_munu_addr, &ben_enter_munuout},
		{ben_angle_munu_addr, &ben_angle_munuout},
		{start_distance_munu_addr, &start_distance_munuout},
	};

	iap_erase_page(Erase_EEPROM);
	for (i = 0; i < (uint8)(sizeof(items) / sizeof(items[0])); i++)
	{
		manu_eeprom_write_u16(items[i].addr, *items[i].value);
	}
}

