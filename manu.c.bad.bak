static void manu_menu_init(const ManuMenu *root)
{
	manu_menu_state.current = root;
	manu_menu_state.selected = 1;
	manu_menu_state.editing = 0;
	manu_exit_request = 0;
}

static ManuKeyEvent manu_key_confirm(void)
{
	/* 列表模式：P37 上移、P36 下移；编辑模式里在 handle_key 里映射为 +/- */
	if (gpio_get_level(IO_P37) == 0)
	{
		Manu_keydelay(IO_P37);
		return MANU_KEY_UP;
	}
	if (gpio_get_level(IO_P36) == 0)
	{
		Manu_keydelay(IO_P36);
		return MANU_KEY_DOWN;
	}
	if (gpio_get_level(IO_P45) == 0)
	{
		Manu_keydelay(IO_P45);
		return MANU_KEY_BACK;
	}
	if (gpio_get_level(IO_P46) == 0)
	{
		Manu_keydelay(IO_P46);
		return MANU_KEY_ENTER;
	}
	return MANU_KEY_NONE;
}

static void manu_edit_enter(ManuMenuItem *item)
{
	uint16 value;
	float show_float;
	manu_edit_item = item;
	manu_menu_state.editing = 1;
	manu_edit_origin = manu_eeprom_read_u16(item->eeprom_addr);

	tft180_clear(RGB565_BLACK);
	tft180_show_string(8, 16 * 0, (char *)item->edit_label);
	tft180_show_string(8, 16 * 3, (char *)item->elast_label);
	tft180_show_uint16(8, 16 * 4, manu_edit_origin);

	value = *item->value_ptr;
	manu_last_local = (uint16)(~value);
	manu_last_float = -1.0f;
	tft180_show_uint16(8, 16 * 1, value);
	tft180_show_uint16(8, 16 * 2, value);
	show_float = (float)value * item->scale_k;
	tft180_show_float(8, 16 * 5, show_float, 6, 6);
	manu_last_local = value;
	manu_last_float = show_float;
}

static void manu_edit_refresh(uint8 force)
{
	uint16 value;
	float show_float;
	if (!manu_edit_item)
	{
		return;
	}
	value = *manu_edit_item->value_ptr;
	show_float = (float)value * manu_edit_item->scale_k;
	if (force || manu_last_local != value)
	{
		tft180_show_uint16(8, 16 * 1, value);
		tft180_show_uint16(8, 16 * 2, value);
		manu_last_local = value;
	}
	if (force || manu_last_float != show_float)
	{
		tft180_show_float(8, 16 * 5, show_float, 6, 6);
		manu_last_float = show_float;
	}
}

static void manu_edit_exit(void)
{
	manu_menu_state.editing = 0;
	manu_edit_item = 0;
	manu_menu_state.current->render();
	Manu_show_cursor(manu_menu_state.selected);
}

static void manu_menu_handle_key(ManuKeyEvent event)
{
	ManuMenuItem *item;
	uint8 index;

	if (event == MANU_KEY_NONE)
	{
		return;
	}

	if (manu_menu_state.editing)
	{
		if (!manu_edit_item)
		{
			manu_menu_state.editing = 0;
			return;
		}
		/* 保持旧 manu 行为：P36 加、P37 减 */
		if (event == MANU_KEY_UP)
		{
			(*manu_edit_item->value_ptr)--;
			manu_edit_refresh(1);
		}
		else if (event == MANU_KEY_DOWN)
		{
			(*manu_edit_item->value_ptr)++;
			manu_edit_refresh(1);
		}
		else if (event == MANU_KEY_ENTER || event == MANU_KEY_BACK)
		{
			manu_edit_exit();
		}
		return;
	}

	/* 浏览模式 */
	if (event == MANU_KEY_UP)
	{
		if (manu_menu_state.selected > 1)
		{
			manu_menu_state.selected--;
		}
		else
		{
			manu_menu_state.selected = manu_menu_state.current->item_count;
		}
		Manu_show_cursor(manu_menu_state.selected);
		return;
	}
	if (event == MANU_KEY_DOWN)
	{
		if (manu_menu_state.selected < manu_menu_state.current->item_count)
		{
			manu_menu_state.selected++;
		}
		else
		{
			manu_menu_state.selected = 1;
		}
		Manu_show_cursor(manu_menu_state.selected);
		return;
	}
	if (event == MANU_KEY_BACK)
	{
		if (manu_menu_state.current->parent)
		{
			manu_menu_state.current = manu_menu_state.current->parent;
			manu_menu_state.selected = 1;
			manu_menu_state.current->render();
			Manu_show_cursor(manu_menu_state.selected);
		}
		else
		{
			/* 主菜单按返回：保存并退出（保持原 Manu_one 行为） */
			manu_save_all_to_eeprom();
			manu_exit_request = 1;
		}
		return;
	}
	if (event == MANU_KEY_ENTER)
	{
		index = manu_menu_state.selected;
		if (index < 1 || index > manu_menu_state.current->item_count)
		{
			return;
		}
		item = &manu_menu_state.current->items[index - 1];
		if (item->child)
		{
			manu_menu_state.current = item->child;
			manu_menu_state.selected = 1;
			manu_menu_state.current->render();
			Manu_show_cursor(manu_menu_state.selected);
		}
		else if (item->action)
		{
			item->action();
			manu_menu_state.current->render();
			Manu_show_cursor(manu_menu_state.selected);
		}
		else if (item->value_ptr)
		{
			manu_edit_enter(item);
		}
		return;
	}
}

static void manu_menu_loop(void)
{
	while (!manu_exit_request)
	{
		manu_key = manu_key_confirm();
		manu_menu_handle_key(manu_key);
		system_delay_ms(1);
	}
}
